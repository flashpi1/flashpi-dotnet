<Project>
  <!-- Settings shared by every project of the repository. -->
  <PropertyGroup>
    <!-- Pinned, so a newer SDK (CI also builds with .NET 11) compiles the same language. -->
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The .NET analyzers at the recommended level, pinned like the language. -->
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <!-- Also what IDE0005 (unused usings) needs on build. Only the library documents every
         public member (CS1591). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn Condition="'$(MSBuildProjectName)' != 'Flashpi'">$(NoWarn);CS1591</NoWarn>
    <!-- Every assembly is strong-named with the repository's key, which is public (Microsoft's
         advice for open-source libraries): signed .NET Framework apps can only load signed
         assemblies. Changing the key breaks every user's build, so it never changes. -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)Flashpi.snk</AssemblyOriginatorKeyFile>
    <!-- Its public key, for InternalsVisibleTo (public key token ef9aa817232f071d). -->
    <FlashpiPublicKey></FlashpiPublicKey>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Package versions live in Directory.Packages.props. -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
</Project>
