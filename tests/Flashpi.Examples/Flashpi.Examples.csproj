<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The C# blocks of README.md and README.en.md (Readme/, generated by `readme generate` of
       tools/Flashpi.Tools), compiled as a web project with the implicit usings a user's project
       has. They are only built, never run. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Flashpi.Examples</RootNamespace>
    <!-- README code is checked by the compiler (nullable included), not by the style rules. -->
    <AnalysisLevel>none</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <NoWarn>$(NoWarn);CS1998</NoWarn>
  </PropertyGroup>

  <!-- What the first block of each README imports, for the blocks that continue it. -->
  <ItemGroup>
    <Using Include="Flashpi" />
    <Using Include="Flashpi.Models" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Flashpi/Flashpi.csproj" />
  </ItemGroup>

</Project>
