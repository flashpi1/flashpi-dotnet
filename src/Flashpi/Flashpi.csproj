<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 has no dependencies. netstandard2.0 serves .NET Framework 4.6.2 and later and
         .NET 8 and 9, with the System.Text.Json and Microsoft.Bcl.AsyncInterfaces packages. -->
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>Flashpi</RootNamespace>
    <AssemblyName>Flashpi</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PackageId>Flashpi</PackageId>
    <Version>0.0.0</Version> <!-- x-release-please-version -->
    <Description>Official .NET SDK for Flashpi, the electronic invoicing API for Ecuador's SRI.</Description>
    <Authors>SIGNIADIGITAL S.A.</Authors>
    <Company>SIGNIADIGITAL S.A.</Company>
    <Copyright>Copyright (c) 2026 SIGNIADIGITAL S.A.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://flashpi.com.ec/docs/sdks/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/flashpi1/flashpi-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PackageTags>flashpi;sri;ecuador;facturacion-electronica;e-invoicing;invoice;api;sdk</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Both builds must expose the same API. -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Flashpi.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

</Project>
