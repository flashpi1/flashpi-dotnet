<Project Sdk="Microsoft.NET.Sdk">

  <!-- The repository's own tooling: the OpenAPI generator and the README example extractor.
       Run it with the arguments openapi sync|generate|check or readme generate|check
       (see Program.cs). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Flashpi.Tools</RootNamespace>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Flashpi.Tests" />
  </ItemGroup>

</Project>
